{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ must match the user access token's user ID." : {
      "comment" : "An error when a supplied user ID does not match the authenticated user token. The placeholder is the Twitch parameter name."
    },
    "An app access token is required." : {
      "comment" : "An error when an endpoint requires an app OAuth access token."
    },
    "An IRC chat writer is not configured." : {
      "comment" : "An error when sending raw IRC traffic without an IRC writer configured."
    },
    "An OAuth user or app access token is required." : {
      "comment" : "An error when an operation requires an OAuth access token rather than an Extension JWT."
    },
    "A user access token is required." : {
      "comment" : "An error when an operation requires a user OAuth access token."
    },
    "Authentication Error: %@" : {
      "comment" : "An incompatible credential or token-dependent parameter. The placeholder contains the authentication error detail."
    },
    "Cancelled" : {
      "comment" : "The error message when the user cancels an action.",
      "isCommentAutoGenerated" : true
    },
    "Chat channel not found." : {
      "comment" : "An error when Twitch returns no channel matching the requested ID or login."
    },
    "Chat channel was parted." : {
      "comment" : "An error when a managed chat channel is parted before a pending operation completes."
    },
    "Chat message refused." : {
      "comment" : "A generic error when local managed chat send admission refuses a message."
    },
    "Chat message refused: %@" : {
      "comment" : "An error when local managed chat send admission refuses a message with a diagnostic reason."
    },
    "Chat message refused: account is banned in this channel." : {
      "comment" : "An error when local send admission sees the account is banned in the channel."
    },
    "Chat message refused: account is timed out in this channel." : {
      "comment" : "An error when local send admission sees the account is timed out in the channel."
    },
    "Chat message refused: account send rate limit reached." : {
      "comment" : "An error when local send admission sees the account's 30-second send window is full."
    },
    "Chat message refused: channel cooldown active." : {
      "comment" : "An error when local send admission sees a per-channel cooldown is active."
    },
    "Chat message rejected (%@): %@" : {
      "comment" : "An error when Twitch rejects a chat message with a drop code and explanation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Chat message rejected (%1$@): %2$@"
          }
        }
      }
    },
    "Chat message rejected: %@" : {
      "comment" : "An error when Twitch rejects a chat message without a drop code."
    },
    "Chat setup failed: %@" : {
      "comment" : "An error when managed chat fails to set up a channel's reader or subscriptions."
    },
    "Client credentials changed." : {
      "comment" : "An error when client credentials change while a managed chat operation is pending."
    },
    "Client nonces are only supported when sending over IRC." : {
      "comment" : "An error when a client nonce is passed to sendMessage with a Helix writer."
    },
    "EventSub disconnected: %@" : {
      "comment" : "An error when an EventSub WebSocket disconnects unexpectedly."
    },
    "EventSub subscription revoked: %@" : {
      "comment" : "An error when Twitch revokes an EventSub subscription. The placeholder is the revocation status."
    },
    "EventSub timed out." : {
      "comment" : "An error when an EventSub WebSocket misses its handshake, keepalive, or reconnect deadline."
    },
    "Invalid %@: %@" : {
      "comment" : "An error when a request parameter fails local validation. First placeholder is the parameter name, second is the reason.",
      "localizations" : {
